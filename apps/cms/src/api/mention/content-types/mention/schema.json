{
  "kind": "collectionType",
  "collectionName": "mentions",
  "info": {
    "singularName": "mention",
    "pluralName": "mentions",
    "displayName": "Mention",
    "description": "A social mention ingested from the mention source"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "externalId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "content": {
      "type": "text",
      "required": true
    },
    "authorHandle": {
      "type": "text"
    },
    "url": {
      "type": "text"
    },
    "postedAt": {
      "type": "datetime"
    },
    "receivedAt": {
      "type": "datetime"
    },
    "channel": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::channel.channel",
      "inversedBy": "mentions"
    },
    "sentimentScore": {
      "type": "decimal"
    },
    "sentimentLabel": {
      "type": "enumeration",
      "enum": [
        "positive",
        "neutral",
        "negative",
        "na"
      ],
      "description": "na = not about Strapi; excluded from the Pulse score (score cleared)"
    },
    "analysisStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "analyzed",
        "failed",
        "skipped"
      ],
      "default": "pending"
    },
    "quality": {
      "type": "enumeration",
      "enum": [
        "normal",
        "suspected-spam",
        "spam"
      ],
      "default": "normal",
      "description": "spam = muted author or confirmed slop: hidden from queue AND excluded from all analytics"
    },
    "lane": {
      "type": "enumeration",
      "enum": [
        "respond",
        "lead",
        "monitor"
      ],
      "default": "respond",
      "description": "routing: respond = reply work; lead = someone shopping or leaving a competitor; monitor = competitor/industry discourse kept for analytics but out of the reply queue"
    },
    "laneReason": {
      "type": "text",
      "description": "which rule produced the lane \u2014 so a wrong route is fixable rather than mysterious"
    },
    "laneEvidence": {
      "type": "text",
      "description": "the author's own verbatim words showing intent, verified to appear in the content. The artifact a human reads before reaching out, and what makes a lead auditable rather than a black box."
    },
    "matchedKeywords": {
      "type": "json",
      "description": "search terms Octolens matched, with keywordTag (own_brand | competitor | industry_term)"
    },
    "keywordTag": {
      "type": "string",
      "description": "strongest matched tag; own_brand beats industry_term beats competitor"
    },
    "authorName": {
      "type": "string",
      "description": "display name from Octolens (authorName)"
    },
    "authorProfileUrl": {
      "type": "string",
      "description": "canonical profile URL \u2014 the strong identity key, present on 95% of rows"
    },
    "authorAvatarUrl": {
      "type": "string"
    },
    "authorFollowers": {
      "type": "integer",
      "description": "point-in-time follower count at posting; person.followers holds the latest. Reliable on X only."
    },
    "relevanceScore": {
      "type": "decimal",
      "description": "Octolens's own relevance score \u2014 an independent second opinion on our classifier"
    },
    "relevanceComment": {
      "type": "text"
    },
    "qualityReason": {
      "type": "text",
      "description": "why this was flagged \u2014 free text from whoever judged it (agent rubric hit, or a human note). Makes the confirm pass readable instead of a re-judge."
    },
    "qualityVia": {
      "type": "string",
      "description": "what set the quality: app | mcp:<client> | mute:<handle> | ingest"
    },
    "analysisAttempts": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "unanswered",
        "claimed",
        "answered",
        "resolved",
        "acknowledged"
      ],
      "default": "unanswered"
    },
    "acknowledgeReason": {
      "type": "enumeration",
      "enum": [
        "competitor",
        "not-relevant",
        "watching",
        "own-post",
        "spam"
      ],
      "description": "why it was closed without a reply. 'spam' is written by the mute flow only (system, no actor) \u2014 humans use the spam flag button instead"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "assignee": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "suggestedTeam": {
      "type": "enumeration",
      "enum": [
        "devrel",
        "marketing",
        "product"
      ]
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "inversedBy": "mentions"
    },
    "draftText": {
      "type": "text"
    },
    "draftedAt": {
      "type": "datetime"
    },
    "draftedVia": {
      "type": "string"
    },
    "humanCorrected": {
      "type": "boolean",
      "default": false
    },
    "modelVersion": {
      "type": "string"
    },
    "promptVersion": {
      "type": "string"
    },
    "responses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::response.response",
      "mappedBy": "mention"
    },
    "activities": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::activity.activity",
      "mappedBy": "mention"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "mention"
    },
    "raw": {
      "type": "json"
    },
    "person": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::person.person",
      "inversedBy": "mentions"
    },
    "postKind": {
      "type": "enumeration",
      "enum": [
        "unknown",
        "original",
        "reply"
      ],
      "default": "unknown"
    },
    "venue": {
      "type": "string"
    },
    "leadDirection": {
      "type": "enumeration",
      "enum": [
        "none",
        "open",
        "toward-us",
        "away-from-us"
      ],
      "default": "none"
    },
    "threadKey": {
      "type": "string"
    }
  }
}
