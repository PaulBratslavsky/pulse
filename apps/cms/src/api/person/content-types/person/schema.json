{
  "kind": "collectionType",
  "collectionName": "people",
  "info": {
    "singularName": "person",
    "pluralName": "people",
    "displayName": "Person",
    "description": "An author, resolved across mentions. The spine for lead tracking: identity, reach, lifecycle and owner."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "displayName": {
      "type": "string"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "unknown",
        "community",
        "own-team",
        "competitor-brand",
        "vendor-bot",
        "publication"
      ],
      "default": "unknown",
      "required": true
    },
    "firstSeenAt": {
      "type": "datetime"
    },
    "lastSeenAt": {
      "type": "datetime"
    },
    "mentionCount": {
      "type": "integer",
      "default": 0
    },
    "leadScore": {
      "type": "integer",
      "default": 0
    },
    "leadBand": {
      "type": "enumeration",
      "enum": [
        "none",
        "watch",
        "warm",
        "hot"
      ],
      "default": "none",
      "required": true
    },
    "leadContext": {
      "type": "json"
    },
    "leadScoredAt": {
      "type": "datetime"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "watching",
        "contacted",
        "qualified",
        "not-a-fit"
      ],
      "default": "new",
      "required": true
    },
    "statusChangedAt": {
      "type": "datetime"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "mergedInto": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::person.person"
    },
    "mentions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::mention.mention",
      "mappedBy": "person"
    },
    "socialAccounts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::social-account.social-account",
      "mappedBy": "person"
    },
    "leadProfile": {
      "type": "component",
      "repeatable": false,
      "component": "shared.lead-profile"
    }
  }
}
