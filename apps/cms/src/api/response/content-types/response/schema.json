{
  "kind": "collectionType",
  "collectionName": "responses",
  "info": {
    "singularName": "response",
    "pluralName": "responses",
    "displayName": "Response",
    "description": "What was replied to a mention, by whom, and how it landed"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "mention": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::mention.mention",
      "inversedBy": "responses"
    },
    "draftText": { "type": "text" },
    "finalText": { "type": "text", "required": true },
    "respondedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "respondedAt": { "type": "datetime" },
    "notes": { "type": "text" },
    "internal": { "type": "boolean", "default": false },
    "outcome": { "type": "component", "component": "shared.outcome", "repeatable": false }
  }
}
