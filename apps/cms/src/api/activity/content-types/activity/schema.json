{
  "kind": "collectionType",
  "collectionName": "activities",
  "info": {
    "singularName": "activity",
    "pluralName": "activities",
    "displayName": "Activity",
    "description": "System-written audit trail entry for a mention workflow transition"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "mention": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::mention.mention",
      "inversedBy": "activities"
    },
    "actor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "action": {
      "type": "enumeration",
      "enum": ["ingested", "analyzed", "claimed", "routed", "corrected", "answered", "resolved", "replayed", "acknowledged", "noted", "drafted"],
      "required": true
    },
    "detail": { "type": "json" },
    "at": { "type": "datetime" }
  }
}
