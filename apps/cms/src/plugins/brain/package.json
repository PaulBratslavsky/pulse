{
  "name": "brain",
  "version": "0.2.0",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p server/tsconfig.build.json && node scripts/build-info.mjs",
    "watch": "tsc -p server/tsconfig.build.json --watch --preserveWatchOutput",
    "verify": "tsc -p server/tsconfig.json --noEmit"
  },
  "strapi": {
    "kind": "plugin",
    "name": "brain",
    "displayName": "Marketing brain"
  }
}
