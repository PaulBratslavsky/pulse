{
  "name": "octolens",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./admin/src/index.ts",
      "default": "./admin/src/index.ts"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p server/tsconfig.build.json",
    "watch": "tsc -p server/tsconfig.build.json --watch --preserveWatchOutput",
    "verify": "tsc -p server/tsconfig.json --noEmit"
  },
  "strapi": {
    "kind": "plugin",
    "name": "octolens",
    "displayName": "Octolens"
  }
}
