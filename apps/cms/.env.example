# ---- Strapi core (Strapi Cloud injects these in production) ----
HOST=0.0.0.0
PORT=1338
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ---- Database (local dev: SQLite; Strapi Cloud injects Postgres) ----
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ---- Pulse: ingest ----
# dev default matches the e2e suite; override with a real secret in production
OCTOLENS_WEBHOOK_SECRET=dev-secret-123

# ---- Pulse: AI (OPTIONAL — leave AI_API_KEY empty to run without AI:
#      analysis/drafts/chat are disabled, everything else works; skipped
#      mentions are auto-analyzed once a key is added) ----
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_DAILY_TOKEN_BUDGET=500000
STRAPI_DOCS_MCP_URL=

# ---- Pulse: notifications (empty = log-only locally) ----
SLACK_WEBHOOK_URL=
SLACK_OPS_WEBHOOK_URL=
PULSE_APP_URL=http://localhost:3000
STALE_AFTER_DAYS=2

# ---- Feature flags ----
MCP_ENABLED=true
CRON_ENABLED=true

# ---- Octolens pull-sync (optional — reconciliation + on-demand backfill) ----
# Read-scope API key from app.octolens.com. Empty = sync disabled (webhook-only).
OCTOLENS_API=
